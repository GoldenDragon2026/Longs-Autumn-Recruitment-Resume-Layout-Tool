# ============================================================
# 龙氏秋招简历编写布局工具 · 环境变量示例
# 复制本文件为 .env 后按需修改（.env 已被 .gitignore 排除，不会入库）
# ============================================================

# 本地开发服务器端口（tools/dev_server.py 使用；命令行 --port 优先级更高）
PORT=8000

# 启动开发服务器后是否自动打开浏览器（1=打开，0=不打开）
OPEN_BROWSER=1
